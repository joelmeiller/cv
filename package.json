{
  "name": "cv-joel",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "start": "meteor run --settings settings/dev.json --port 4000 --exclude-archs web.browser.legacy",
    "test": "meteor test --once --driver-package meteortesting:mocha",
    "test-app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "visualize": "meteor --production --extra-packages bundle-visualizer --settings settings/dev.json",
    "deploy": "meteor npm version minor && DEPLOY_HOSTNAME=eu-west-1.galaxy.meteor.com meteor deploy joel.oscillate.ch --settings settings/live.json"
  },
  "dependencies": {
    "@ant-design/icons": "^4.8.1",
    "@babel/runtime": "^7.23.2",
    "antd": "^4.24.14",
    "bcrypt": "^5.1.1",
    "classnames": "^2.3.2",
    "indexof": "0.0.1",
    "meteor-node-stubs": "^1.2.5",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-komposer": "^2.0.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "styled-components": "^5.3.11"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "eslintConfig": {
    "parser": "babel-eslint",
    "parserOptions": {
      "sourceType": "module",
      "allowImportExportEverywhere": true,
      "ecmaVersion": "2018"
    },
    "plugins": [
      "import",
      "meteor",
      "prettier",
      "react"
    ],
    "extends": [
      "plugin:react/recommended",
      "plugin:meteor/recommended",
      "prettier"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.js",
          "tests/**/*.js"
        ],
        "rules": {
          "max-lines": "off"
        }
      }
    ],
    "settings": {
      "react": {
        "version": "16.0"
      }
    },
    "rules": {
      "max-lines": "off",
      "prettier/prettier": "error",
      "react/require-default-props": "off",
      "react/no-unescaped-entities": "off",
      "react/no-deprecated": "off",
      "newline-per-chained-call": "off"
    }
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.jsx",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "@types/react": "^18.2.37",
    "@types/styled-components": "^5.1.30",
    "babel-plugin-import": "^1.13.8",
    "babel-plugin-styled-components": "^1.13.3",
    "prettier": "^2.8.8"
  }
}
